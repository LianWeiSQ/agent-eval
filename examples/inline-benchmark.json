{
  "manifest": {
    "id": "hello-agent-example",
    "name": "Hello Agent Example",
    "version": "1.0.0",
    "benchmark_type": "general",
    "pass_threshold": 80,
    "license": "CC0-1.0"
  },
  "tasks": [
    {
      "id": "HELLO-001",
      "version": "1.0.0",
