      },
      "agent_requirements": {},
      "graders": [
        {
          "id": "hello-rule-v1",
          "type": "rule",
          "weight": 1,
          "config": {
            "contains": [
              "hello-eval-v1"
            ],
            "max_tool_calls": 0
          }
        }
