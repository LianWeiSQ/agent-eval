# Runtime data and evaluation outputs (never source assets)
.data/
.data-*/
runs/
results/
reports/
artifacts/
logs/
*.log
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.pid

# Downloaded benchmark tasks, images, runtimes and generated registrations
# Only the MMLU definition is distributed; Terminal-Bench is imported on demand.
/benchmarks/*
!/benchmarks/mmlu-high-school-computer-science-smoke/
.terminal-bench/
.terminal-bench-venv/
benchmarks/terminal-bench-*/package.json
benchmarks/terminal-bench-*/source-lock.json
benchmarks/terminal-bench-*/validation.json

# Local credentials and configuration
.env
.env.*
!.env.example
*.pem
*.key
.credentials*
.dsh/
.codex/
.agents/
langfuse/.env

# Dependencies, build products and editor caches
.venv/
venv/
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.vscode/
.idea/
.DS_Store
Thumbs.db
